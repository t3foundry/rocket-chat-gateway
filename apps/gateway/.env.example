# Rocket.Chat servers the gateway fronts.
# A bare URL configures a single server; a JSON array configures several:
#   ROCKETCHAT_SERVERS=[{"id":"acme","name":"Acme","url":"http://rocketchat:3000","publicUrl":"https://chat.acme.com"}]
# ROCKETCHAT_SERVERS=http://localhost:3000
ROCKETCHAT_SERVERS='[
  {"id":"default","name":"Local","url":"http://localhost:3000"},
  {"id":"open","name":"open.rocket.chat","url":"https://open.rocket.chat","publicUrl":"https://open.rocket.chat"}
]'

# Signs the session cookie. Must be at least 32 characters and stable across
# restarts, or every session is invalidated on deploy.
# Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-random-48-byte-string-before-production

# Browser origins allowed to call the API with credentials (comma separated).
CORS_ORIGINS=http://localhost:5173

PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=debug

# Session cookie
SESSION_COOKIE_NAME=orc_session
SESSION_TTL_SECONDS=604800
# Use `none` (plus HTTPS) when the frontend is on a different site.
SESSION_COOKIE_SAMESITE=lax
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_DOMAIN=.example.com

# Omit to keep sessions in memory (single instance, lost on restart).
# REDIS_URL=redis://localhost:6379

MAX_UPLOAD_BYTES=104857600
# How long one file may take to reach Rocket.Chat. Raise it alongside
# MAX_UPLOAD_BYTES, or whenever the Rocket.Chat server is far enough away that
# a large upload cannot finish inside the window.
UPLOAD_TIMEOUT_SECONDS=300
REALTIME_IDLE_TIMEOUT_SECONDS=30
