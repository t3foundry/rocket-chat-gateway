{
  "name": "@open-rocket-chat/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Backend-for-frontend that fronts a Rocket.Chat server with a stable, version-independent API",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --exec \"node --env-file-if-exists=.env\"",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "@open-rocket-chat/api-contract": "workspace:*",
    "@open-rocket-chat/rc-adapter": "workspace:*",
    "@open-rocket-chat/rc-realtime-client": "workspace:*",
    "@open-rocket-chat/rc-rest-client": "workspace:*",
    "fastify": "^5.11.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.1.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
