# Copy to .env before running the stack:
#   cp .env.example .env
#   docker compose -f docker/stack.compose.yml up -d --build
#
# Docker Compose reads .env from the project directory automatically.
# Every variable here is also accepted as a shell environment variable
# (export VAR=…), which takes precedence over the .env file.
#
# For local gateway development (no Docker), see apps/gateway/.env.example.

# ── Rocket.Chat ───────────────────────────────────────────────────────────────

RC_VERSION=8.6.1
RC_ROOT_URL=http://localhost:3000
RC_PORT=3000

# First-run admin account; ignored when the admin already exists.
RC_ADMIN_USERNAME=admin
RC_ADMIN_PASSWORD=admin-password-123
RC_ADMIN_EMAIL=admin@example.com

# ── Gateway ───────────────────────────────────────────────────────────────────

GATEWAY_PORT=4000
LOG_LEVEL=info

# Rocket.Chat servers the gateway fronts.  url is internal (compose network);
# publicUrl is what the frontend sees, used only for deep links.
ROCKETCHAT_SERVERS='[{"id":"default","name":"Rocket.Chat","url":"http://rocketchat:3000","publicUrl":"http://localhost:3000"}]'

# Signs the session cookie.  Must be at least 32 characters and stable across
# restarts, or every session is invalidated on deploy.  Required.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Comma-separated browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173

# ── Tasra (encrypted channels) ────────────────────────────────────────────────
# All are optional.  Omit to leave issuance disabled.

# Signs credentials this gateway issues: 0x-prefixed 32-byte hex seed.
# Generate with: echo 0x$(openssl rand -hex 32)
# TASRA_ISSUER_SEED=

# EVM signing key for OID4VP sessions: 0x-prefixed 32-byte hex seed
# (secp256k1 private key).  The derived EVM address must be a creator or
# delegate of every slot the gateway issues credentials for.
# TASRA_CREATOR_SEED=

# JSON-RPC endpoint for the chain the Tasra contracts are deployed on.
# TASRA_RPC_URL=
# TASRA_CHAIN_ID=

# JSON object of contract addresses.  At minimum KeyRegistry is required.
# TASRA_DEPLOYMENT_ADDRESSES=