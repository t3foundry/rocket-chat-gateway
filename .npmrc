# NestJS relies on reflect-metadata and decorator metadata resolved from the
# root; a strict store would break its runtime injection lookups.
shamefully-hoist=false
# Every workspace project declares `engines.node >= 24.7.0`; enforce it rather
# than warn, so a too-old Node fails at install instead of at `require(esm)`.
engine-strict=true
strict-peer-dependencies=false
auto-install-peers=true
link-workspace-packages=true
prefer-workspace-packages=true
