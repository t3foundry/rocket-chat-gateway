{
  "name": "@t3foundry/open-rocket-chat-rc-adapter",
  "version": "0.1.1",
  "description": "Normalises Rocket.Chat wire records into the Open Rocket.Chat domain model",
  "license": "MIT",
  "engines": {
    "node": ">=24.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zscontributor/open-rocket-chat-gateway.git",
    "directory": "packages/rc-adapter"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@t3foundry/open-rocket-chat-api-contract": "workspace:*",
    "@t3foundry/open-rocket-chat-rc-rest-client": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
